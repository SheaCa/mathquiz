<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".highSchoolUnits">


  <TextView
      android:id="@+id/text1"
      android:layout_width="match_parent"
      android:layout_height="80dp"
        android:textSize="74sp"
        android:text="PICK A UNIT"
        android:background="@color/black"
        android:textColor="@color/white"
      />

  <Button
      android:id="@+id/unitbutton1"
      android:layout_width="match_parent"
      android:layout_height="60dp"
      android:text="Calculus"
      android:textSize="30sp"
      />

 <Button
     android:id="@+id/unitbutton2"
     android:layout_width="match_parent"
     android:layout_height="60dp"
       android:text="Algebra 1"
       android:textSize="30sp"
     android:onClick="alg1btn"
     />

  <Button
      android:id="@+id/unitbutton3"
      android:layout_width="match_parent"
      android:layout_height="60dp"
      android:text="Geometry"
      android:textSize="30sp"
      />

      <Button
          android:id="@+id/unitbutton4"
          android:layout_width="wrap_content"
          android:layout_height="60dp"
        android:text="Back"
          android:textSize="25sp"
          />

</LinearLayout>