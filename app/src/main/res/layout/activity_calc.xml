<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:orientation="vertical"
    tools:context=".CalcActivity">

    <TextView
        android:id="@+id/textView9"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="What is the derivative of the function f(x)=4cos2x+logx+x"
        android:textSize="40sp"/>

    <Button
        android:id="@+id/button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="A. 8sin2x+1/x+x"
        android:textSize="40sp"
        android:onClick="incorrectScreen"/>

    <Button
        android:id="@+id/button29"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="B. -8sin2x+1/x+x"
        android:textSize="40sp"
        android:onClick="incorrectScreen"/>

    <Button
        android:id="@+id/button30"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="C. -8sin2x+1/x+1"
        android:textSize="40sp"
        android:onClick="calc2"/>

    <Button
        android:id="@+id/button31"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="D. 8sin2x+1/x+1"
        android:textSize="40sp"
        android:onClick="incorrectScreen"/>

    <Button
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:text="Home"
        android:textSize="25sp"
        android:onClick="backBtn" />


</LinearLayout>