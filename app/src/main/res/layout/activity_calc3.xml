<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:orientation="vertical"
    tools:context=".Calc3Activity">


    <TextView
        android:id="@+id/textView10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="What is the derivative of: (x + 1) sin x?"
        android:textSize="40sp"/>

    <Button
        android:id="@+id/button36"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="A. sin x + (x + 1) cos x"
        android:textSize="36sp"
        android:onClick="calc4"/>

    <Button
        android:id="@+id/button37"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="B. sin x"
        android:textSize="40sp"
        android:onClick="incorrectScreen"/>

    <Button
        android:id="@+id/button38"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="C. (x + 1) tan x"
        android:textSize="40sp"
        android:onClick="incorrectScreen"/>

    <Button
        android:id="@+id/button39"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="D. (x + 2) cos x"
        android:textSize="40sp"
        android:onClick="incorrectScreen"/>

    <Button
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:text="Home"
        android:textSize="25sp"
        android:onClick="backBtn" />

</LinearLayout>