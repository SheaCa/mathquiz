<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:orientation="vertical"
    tools:context=".Calc4Activity">


<TextView
        android:id="@+id/textView11"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="What is the integral of the function f(x) = sin 2x?"
        android:textSize="36sp"/>

    <Button
        android:id="@+id/button40"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="A. (1/2) sin x + C"
        android:textSize="40sp"
        android:onClick="incorrectScreen"/>

    <Button
        android:id="@+id/button41"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="B. (-1/2) cos 2x + C"
        android:textSize="40sp"
        android:onClick="calc5"/>

    <Button
        android:id="@+id/button42"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="C. (1/2) sin 2x + C"
        android:textSize="40sp"
        android:onClick="incorrectScreen"/>

    <Button
        android:id="@+id/button43"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="D. (-1/2) cos x + C"
        android:textSize="44sp"
        android:onClick="incorrectScreen"/>

    <Button
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:text="Home"
        android:textSize="25sp"
        android:onClick="backBtn" />

</LinearLayout>